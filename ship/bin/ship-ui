#!/usr/bin/env python3
"""
ship-ui: render a decision gate as a real window, take the answers back.

A gate is a `review.json` describing what the agent found, what it intends, and
what it still needs decided. This serves that as a local page, opens a
chromeless browser window on it, and accepts the answers over POST so they land
in `answers.json` + `ANSWERS.md` without anyone copying anything.

    ship-ui <dir> [--no-open] [--print-url] [--port N] [--timeout SECONDS]

The agent is expected to launch this in the background and then poll for
`answers.json`. The server stops itself once answers are saved, or after
--timeout seconds of nothing (default: no timeout).

Only the standard library. python3 is the single requirement.

review.json — every key optional except `title`:

    {
      "title":    "DEV-188  Direct Product RFQ",
      "subtitle": "stage 1 of 5",
      "stage":    "UNDERSTAND",
      "meta":     {"branch": "...", "lane": "full", "id": "..."},
      "figures":  [{"caption","claim","tone":"dim|good|bad|warn",
                    "art":["ascii","lines"], "svg":"<svg .../>"}],
      "notes":    [{"heading","lines":[]}],
      "phases":   [{"id","name","state":"done|next|planned|blocked","commit",
                    "what":[],"files":[],"proof"}],
      "questions":[{"id","q","why":[],"multi":false,
                    "options":[{"id","label","detail","cost"}],
                    "rec":"option-id","rec_why":""}],
      "findings": [{"id","lens","severity":"blocker|high|medium|low",
                    "title","repro","observed","verdict":"confirmed|refuted|open",
                    "file","line","status":"fixed|open"}],
      "checks":   [{"id","label"}],
      "actions":  [{"id","label","detail","kind":"primary|danger|normal"}],
      "evidence": [{"path","line","note"}]
    }
"""

import argparse
import errno
import html
import http.server
import json
import os
import socket
import socketserver
import subprocess
import sys
import threading
import time
import webbrowser
from datetime import datetime

SPEC_NAME = "review.json"
ANSWERS_JSON = "answers.json"
ANSWERS_MD = "ANSWERS.md"

KEYS = ("figures", "notes", "phases", "questions", "findings", "checks",
        "actions", "evidence")


# --------------------------------------------------------------- spec io ---

def load_spec(directory):
    path = os.path.join(directory, SPEC_NAME)
    if not os.path.exists(path):
        sys.exit("ship-ui: no %s in %s" % (SPEC_NAME, directory))
    try:
        with open(path) as fh:
            spec = json.load(fh)
    except ValueError as exc:
        sys.exit("ship-ui: %s is not valid JSON: %s" % (path, exc))
    if not isinstance(spec, dict):
        sys.exit("ship-ui: %s must be a JSON object" % path)
    spec.setdefault("title", "review")
    spec.setdefault("subtitle", "")
    spec.setdefault("stage", "")
    spec.setdefault("meta", {})
    for key in KEYS:
        value = spec.get(key)
        spec[key] = value if isinstance(value, list) else []
    return spec


def load_answers(directory):
    blank = {"answers": {}, "notes": {}, "checks": {}, "action": None}
    path = os.path.join(directory, ANSWERS_JSON)
    if not os.path.exists(path):
        return blank
    try:
        with open(path) as fh:
            saved = json.load(fh)
    except (ValueError, OSError):
        return blank
    out = dict(blank)
    for key in ("answers", "notes", "checks"):
        if isinstance(saved.get(key), dict):
            out[key] = saved[key]
    if isinstance(saved.get("action"), str):
        out["action"] = saved["action"]
    return out


def option_label(question, option_id):
    for opt in question.get("options", []) or []:
        if opt.get("id") == option_id:
            return opt.get("label", option_id)
    return option_id


def write_answers(directory, spec, payload):
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    record = {
        "saved_at": stamp,
        "title": spec.get("title", ""),
        "stage": spec.get("stage", ""),
        "answers": payload.get("answers", {}) or {},
        "notes": payload.get("notes", {}) or {},
        "checks": payload.get("checks", {}) or {},
        "action": payload.get("action"),
    }
    with open(os.path.join(directory, ANSWERS_JSON), "w") as fh:
        json.dump(record, fh, indent=2)
        fh.write("\n")

    lines = ["# Answers — %s" % spec.get("title", "review"), ""]
    if spec.get("stage"):
        lines.append("Stage: **%s**" % spec["stage"])
    lines.append("Saved: %s" % stamp)
    lines.append("")

    questions = spec.get("questions") or []
    if questions:
        lines.append("## Decisions")
        lines.append("")
        for question in questions:
            qid = question.get("id") or ""
            chosen = record["answers"].get(qid)
            note = (record["notes"].get(qid) or "").strip()
            lines.append("### %s — %s" % (qid, question.get("q", "")))
            if chosen is None or chosen == "" or chosen == []:
                lines.append("")
                lines.append("**UNANSWERED**")
            elif isinstance(chosen, list):
                labels = [option_label(question, c) for c in chosen]
                lines.append("")
                lines.append("**Chose:** %s" % ", ".join(labels))
            else:
                lines.append("")
                lines.append("**Chose:** %s  `%s`"
                             % (option_label(question, chosen), chosen))
                rec = question.get("rec")
                if rec and rec != chosen:
                    lines.append("")
                    lines.append("_(overrode the recommendation `%s`)_" % rec)
            if note:
                lines.append("")
                for nline in note.splitlines():
                    lines.append("> %s" % nline)
            lines.append("")

    checks = spec.get("checks") or []
    if checks:
        lines.append("## Checks")
        lines.append("")
        for check in checks:
            cid = check.get("id") or ""
            mark = "x" if record["checks"].get(cid) else " "
            lines.append("- [%s] %s" % (mark, check.get("label", cid)))
        lines.append("")

    if record["action"]:
        chosen = record["action"]
        label = chosen
        for action in spec.get("actions") or []:
            if action.get("id") == chosen:
                label = action.get("label", chosen)
        lines.append("## Gate decision")
        lines.append("")
        lines.append("**%s**  `%s`" % (label, chosen))
        lines.append("")

    with open(os.path.join(directory, ANSWERS_MD), "w") as fh:
        fh.write("\n".join(lines).rstrip() + "\n")


# ------------------------------------------------------------------ page ---

