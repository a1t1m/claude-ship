<div id="app"></div>
<script>
const SPEC = __SPEC__;
const SAVED = __SAVED__;

const state = {
  answers: Object.assign({}, SAVED.answers || {}),
  notes:   Object.assign({}, SAVED.notes   || {}),
  checks:  Object.assign({}, SAVED.checks  || {}),
  action:  SAVED.action || null,
  focus:   0,
  saved:   false,
};

const esc = s => String(s == null ? "" : s)
  .replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;")
  .replace(/"/g,"&quot;");

const questions = SPEC.questions || [];
const answeredCount = () => questions.filter(q => {
  const v = state.answers[q.id];
  return Array.isArray(v) ? v.length > 0 : (v !== undefined && v !== null && v !== "");
}).length;

function figuresHTML() {
  if (!(SPEC.figures || []).length) return "";
  return section("map", "Map", SPEC.figures.map(f => `
    <div class="card fig ${esc(f.tone || "")}">
      ${f.claim ? `<p class="claim">${esc(f.claim)}</p>` : ""}
      ${f.svg ? `<div class="svgbox">${f.svg}</div>` : ""}
      ${(f.art && f.art.length) ? `<pre>${esc(f.art.join("\n"))}</pre>` : ""}
      ${f.caption ? `<p class="cap">${esc(f.caption)}</p>` : ""}
    </div>`).join(""));
}

function notesHTML() {
  if (!(SPEC.notes || []).length) return "";
  return section("settled", "Settled", SPEC.notes.map(n => `
    <div class="card note">
      <h3>${esc(n.heading || "")}</h3>
      <ul>${(n.lines || []).map(l => `<li>${esc(l)}</li>`).join("")}</ul>
    </div>`).join(""));
}

function phasesHTML() {
  if (!(SPEC.phases || []).length) return "";
  return section("phases", "Phases", SPEC.phases.map(p => `
    <div class="card phase">
      <div class="pstate ${esc(p.state || "planned")}">${esc(p.state || "planned")}</div>
      <div>
        <h3>${esc(p.id ? p.id + " — " : "")}${esc(p.name || "")}
          ${p.commit ? `<span class="tag">${esc(p.commit)}</span>` : ""}</h3>
        ${(p.what || []).length ? `<ul>${p.what.map(w => `<li>${esc(w)}</li>`).join("")}</ul>` : ""}
        ${(p.files || []).length ? `<div class="files">${p.files.map(esc).join("  ·  ")}</div>` : ""}
        ${p.proof ? `<div class="proof">proof: ${esc(p.proof)}</div>` : ""}
      </div>
    </div>`).join(""));
}

function findingsHTML() {
  if (!(SPEC.findings || []).length) return "";
  return section("findings", "Findings", SPEC.findings.map(f => `
    <div class="card finding">
      <div class="sev ${esc(f.severity || "low")}">${esc(f.severity || "low")}</div>
      <div>
        <h3>${esc(f.title || "")}
          ${f.verdict ? `<span class="tag ${esc(f.verdict)}">${esc(f.verdict)}</span>` : ""}
          ${f.status ? `<span class="tag ${esc(f.status)}">${esc(f.status)}</span>` : ""}</h3>
        <div class="lens">${esc(f.lens || "")}${f.file ? " · " + esc(f.file) + (f.line ? ":" + esc(f.line) : "") : ""}</div>
        ${f.repro ? `<pre>$ ${esc(f.repro)}${f.observed ? "\n" + esc(f.observed) : ""}</pre>` : ""}
      </div>
    </div>`).join(""));
}

function questionsHTML() {
  if (!questions.length) return "";
  const body = questions.map((q, qi) => {
    const cur = state.answers[q.id];
    const multi = !!q.multi;
    const isSel = oid => multi ? (Array.isArray(cur) && cur.includes(oid)) : cur === oid;
    const answered = multi ? (Array.isArray(cur) && cur.length) : (cur !== undefined && cur !== null && cur !== "");
    return `
    <div class="card q ${answered ? "answered" : ""} ${qi === state.focus ? "focus" : ""}" id="q-${esc(q.id)}">
      <div class="qid">${esc(q.id || "")}${multi ? " · pick any" : ""}</div>
      <h3>${esc(q.q || "")}</h3>
      ${(q.why || []).length ? `<div class="why"><ul>${q.why.map(w => `<li>${esc(w)}</li>`).join("")}</ul></div>` : ""}
      <div class="opts">
        ${(q.options || []).map((o, oi) => `
          <div class="opt ${multi ? "multi" : ""} ${isSel(o.id) ? "sel" : ""}"
               data-q="${esc(q.id)}" data-o="${esc(o.id)}">
            <div class="dot"></div>
            <div>
              <div class="lab"><span class="num">${oi + 1}</span>${esc(o.label || o.id)}${
                q.rec === o.id ? `<span class="recbadge">rec</span>` : ""}</div>
              ${o.detail ? `<div class="det">${esc(o.detail)}</div>` : ""}
              ${o.cost ? `<div class="cost">cost: ${esc(o.cost)}</div>` : ""}
            </div>
          </div>`).join("")}
      </div>
      ${q.rec_why ? `<p class="recwhy">why the rec: ${esc(q.rec_why)}</p>` : ""}
      <textarea data-note="${esc(q.id)}" placeholder="note, override, or a different idea entirely…"
        >${esc(state.notes[q.id] || "")}</textarea>
    </div>`;
  }).join("");
  return section("ask", "Decisions", body, `${answeredCount()}/${questions.length}`);
}

function checksHTML() {
  if (!(SPEC.checks || []).length) return "";
  return section("checks", "Checks", `<div class="card">${SPEC.checks.map(c => `
    <div class="check ${state.checks[c.id] ? "on" : ""}" data-check="${esc(c.id)}">
      <div class="box"></div><span>${esc(c.label || c.id)}</span>
    </div>`).join("")}</div>`);
}

function evidenceHTML() {
  if (!(SPEC.evidence || []).length) return "";
  return section("evidence", "Evidence", `<div class="card">${SPEC.evidence.map(e => `
    <div class="ev"><b>${esc(e.path || "")}${e.line ? ":" + esc(e.line) : ""}</b>${
      e.note ? " — " + esc(e.note) : ""}</div>`).join("")}</div>`);
}

function section(id, label, body, count) {
  return `<section id="${id}"><div class="shead"><h2>${esc(label)}</h2>${
    count ? `<span class="count">${esc(count)}</span>` : ""}</div>${body}</section>`;
}

function navHTML() {
  const items = [
    ["map", "Map", (SPEC.figures || []).length],
    ["settled", "Settled", (SPEC.notes || []).length],
    ["phases", "Phases", (SPEC.phases || []).length],
    ["findings", "Findings", (SPEC.findings || []).length],
    ["ask", "Decisions", questions.length],
    ["checks", "Checks", (SPEC.checks || []).length],
    ["evidence", "Evidence", (SPEC.evidence || []).length],
  ].filter(i => i[2]);
  return `<nav>${items.map(i => `<a href="#${i[0]}">${i[1]}</a>`).join("")}</nav>`;
}

function saveBarHTML() {
  const actions = SPEC.actions || [];
  const acts = actions.length ? actions.map(a => `
      <button class="act ${state.action === a.id ? "primary" : (a.kind === "danger" ? "danger" : "")}"
              data-action="${esc(a.id)}" title="${esc(a.detail || "")}">${esc(a.label || a.id)}</button>`).join("")
    : "";
  const need = questions.length - answeredCount();
  return `<div class="savebar"><div class="savein">
    <span class="kbd"><b>1-9</b> pick &nbsp; <b>j</b>/<b>k</b> move &nbsp; <b>⌘↵</b> save</span>
    <span class="spacer" style="flex:1"></span>
    ${acts}
    <button class="act primary" id="savebtn">${
      need > 0 ? `Save &amp; hand back (${need} open)` : "Save &amp; hand back"}</button>
  </div></div>`;
}

function render() {
  if (state.saved) {
    document.getElementById("app").innerHTML =
      `<div class="done"><h2>Handed back.</h2>
       <p>Answers written. You can close this window — the agent has them.</p></div>`;
    return;
  }
  document.getElementById("app").innerHTML = `
    <header><div class="hd">
      <h1>${esc(SPEC.title)}</h1>
      ${SPEC.stage ? `<span class="chip stage">${esc(SPEC.stage)}</span>` : ""}
      ${SPEC.subtitle ? `<span class="sub">${esc(SPEC.subtitle)}</span>` : ""}
      <span class="spacer"></span>
      ${questions.length ? `<span class="progress"><b>${answeredCount()}</b>/${questions.length} answered</span>` : ""}
      <button class="iconbtn" id="theme">◐</button>
    </div>${navHTML()}</header>
    <div class="wrap">
      ${figuresHTML()}${notesHTML()}${phasesHTML()}${findingsHTML()}
      ${questionsHTML()}${checksHTML()}${evidenceHTML()}
    </div>
    ${saveBarHTML()}`;
  wire();
}

function wire() {
  document.querySelectorAll(".opt").forEach(el => el.onclick = () => {
    const qid = el.dataset.q, oid = el.dataset.o;
    const q = questions.find(x => x.id === qid);
    if (q && q.multi) {
      const cur = Array.isArray(state.answers[qid]) ? state.answers[qid].slice() : [];
      const at = cur.indexOf(oid);
      if (at >= 0) cur.splice(at, 1); else cur.push(oid);
      state.answers[qid] = cur;
    } else {
      state.answers[qid] = state.answers[qid] === oid ? undefined : oid;
    }
    state.focus = questions.findIndex(x => x.id === qid);
    render();
  });
  document.querySelectorAll("[data-note]").forEach(el => {
    el.oninput = () => { state.notes[el.dataset.note] = el.value; };
  });
  document.querySelectorAll("[data-check]").forEach(el => el.onclick = () => {
    const id = el.dataset.check;
    state.checks[id] = !state.checks[id];
    render();
  });
  document.querySelectorAll("[data-action]").forEach(el => el.onclick = () => {
    state.action = el.dataset.action; render();
  });
  const sb = document.getElementById("savebtn");
  if (sb) sb.onclick = save;
  const th = document.getElementById("theme");
  if (th) th.onclick = () => {
    const root = document.documentElement;
    root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
  };
}

document.addEventListener("keydown", e => {
  if (state.saved) return;
  const typing = /^(TEXTAREA|INPUT)$/.test(document.activeElement.tagName);
  if ((e.metaKey || e.ctrlKey) && e.key === "Enter") { e.preventDefault(); save(); return; }
  if (typing) return;
  if (e.key === "j" || e.key === "ArrowDown") {
    state.focus = Math.min(state.focus + 1, questions.length - 1); scrollFocus(); return;
  }
  if (e.key === "k" || e.key === "ArrowUp") {
    state.focus = Math.max(state.focus - 1, 0); scrollFocus(); return;
  }
  if (/^[1-9]$/.test(e.key) && questions[state.focus]) {
    const q = questions[state.focus];
    const opt = (q.options || [])[parseInt(e.key, 10) - 1];
    if (!opt) return;
    if (q.multi) {
      const cur = Array.isArray(state.answers[q.id]) ? state.answers[q.id].slice() : [];
      const at = cur.indexOf(opt.id);
      if (at >= 0) cur.splice(at, 1); else cur.push(opt.id);
      state.answers[q.id] = cur;
    } else { state.answers[q.id] = opt.id; }
    render();
  }
});

function scrollFocus() {
  render();
  const q = questions[state.focus];
  if (!q) return;
  const el = document.getElementById("q-" + q.id);
  if (el) el.scrollIntoView({ behavior: "smooth", block: "center" });
}

function save() {
  fetch("/save", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      answers: state.answers, notes: state.notes,
      checks: state.checks, action: state.action,
    }),
  }).then(() => { state.saved = true; render(); })
    .catch(() => alert("Could not hand the answers back — is the agent still running?"));
}

render();
</script>
</body>
</html>
"""


def build_page(spec, saved):
    page = PAGE
    page = page.replace("__TITLE__", html.escape(str(spec.get("title", "review"))))
    page = page.replace("__SPEC__", json.dumps(spec))
    page = page.replace("__SAVED__", json.dumps(saved))
    return page.encode("utf-8")


# ---------------------------------------------------------------- server ---

class Gate:
    def __init__(self, directory, spec, saved):
        self.directory = directory
        self.spec = spec
        self.saved = saved
        self.body = build_page(spec, saved)
        self.done = threading.Event()


def make_handler(gate):
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"

        def log_message(self, *args):
            pass

        def _send(self, code, body, ctype):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            try:
                self.wfile.write(body)
            except (BrokenPipeError, ConnectionResetError):
                pass

        def do_GET(self):
            if self.path in ("/", "/index.html"):
                self._send(200, gate.body, "text/html; charset=utf-8")
            elif self.path == "/health":
                self._send(200, b"ok", "text/plain")
            else:
                self._send(404, b"not found", "text/plain")

        def do_POST(self):
            if self.path != "/save":
                self._send(404, b"not found", "text/plain")
                return
            try:
                length = int(self.headers.get("Content-Length") or 0)
                payload = json.loads(self.rfile.read(length) or b"{}")
            except (ValueError, TypeError):
                self._send(400, b'{"ok":false}', "application/json")
                return
            try:
                write_answers(gate.directory, gate.spec, payload)
            except OSError as exc:
                self._send(500, json.dumps({"ok": False, "error": str(exc)}).encode(),
                           "application/json")
                return
            self._send(200, b'{"ok":true}', "application/json")
            threading.Timer(0.5, gate.done.set).start()

    return Handler


class Server(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    daemon_threads = True


def free_port(preferred=0):
    if preferred:
        try:
            with socket.socket() as sock:
                sock.bind(("127.0.0.1", preferred))
            return preferred
        except OSError as exc:
            if exc.errno not in (errno.EADDRINUSE, errno.EACCES):
                raise
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


APP_BROWSERS = [
    "/Applications/Google Chrome.app",
    "/Applications/Brave Browser.app",
    "/Applications/Microsoft Edge.app",
    "/Applications/Arc.app",
    "/Applications/Chromium.app",
]


def open_window(url):
    """Chromeless app window where possible, ordinary tab otherwise."""
    if sys.platform == "darwin":
        for app in APP_BROWSERS:
            if os.path.isdir(app):
                try:
                    subprocess.Popen(
                        ["open", "-na", app, "--args", "--app=" + url,
                         "--window-size=1120,900"],
                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    return True
                except OSError:
                    break
    for binary in ("google-chrome", "chromium", "brave-browser", "microsoft-edge"):
        try:
            subprocess.Popen([binary, "--app=" + url],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except (OSError, FileNotFoundError):
            continue
    try:
        return webbrowser.open(url)
    except Exception:
        return False


def main():
    parser = argparse.ArgumentParser(
        prog="ship-ui", description="render a decision gate, take the answers back")
    parser.add_argument("directory", nargs="?", default=".",
                        help="directory holding review.json (default: .)")
    parser.add_argument("--port", type=int, default=0)
    parser.add_argument("--no-open", action="store_true",
                        help="serve without opening a window")
    parser.add_argument("--print-url", action="store_true",
                        help="print the URL and keep serving")
    parser.add_argument("--timeout", type=float, default=0,
                        help="give up after N seconds with no answer (0 = wait)")
    args = parser.parse_args()

    directory = os.path.abspath(os.path.expanduser(args.directory))
    if not os.path.isdir(directory):
        sys.exit("ship-ui: not a directory: %s" % directory)

    spec = load_spec(directory)
    saved = load_answers(directory)
    gate = Gate(directory, spec, saved)

    port = free_port(args.port)
    server = Server(("127.0.0.1", port), make_handler(gate))
    threading.Thread(target=server.serve_forever, daemon=True).start()

    url = "http://127.0.0.1:%d/" % port
    print("ship-ui  %s" % spec.get("title", ""))
    print("         %s" % url)
    print("         answers -> %s" % os.path.join(directory, ANSWERS_MD))
    sys.stdout.flush()

    if not args.no_open:
        if not open_window(url):
            print("         (could not open a window — open the URL above)")
            sys.stdout.flush()

    try:
        signalled = gate.done.wait(args.timeout if args.timeout > 0 else None)
    except KeyboardInterrupt:
        signalled = False
    server.shutdown()
    if signalled:
        print("saved")
        return 0
    print("timed out with no answer" if args.timeout > 0 else "interrupted")
    return 1


if __name__ == "__main__":
    sys.exit(main())
